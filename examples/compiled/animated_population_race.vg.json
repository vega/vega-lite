{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A racing bar chart of US population by age group, animated across census years.",
  "background": "white",
  "padding": 5,
  "width": 300,
  "style": "cell",
  "data": [
    {"name": "animation_frame_store"},
    {
      "name": "source_0",
      "url": "data/population.json",
      "format": {"type": "json"},
      "transform": []
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["age", "year"],
          "ops": ["sum"],
          "fields": ["people"],
          "as": ["sum_people"]
        },
        {
          "type": "stack",
          "groupby": ["age"],
          "field": "sum_people",
          "sort": {"field": ["year"], "order": ["ascending"]},
          "as": ["sum_people_start", "sum_people_end"],
          "offset": "zero"
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"sum_people\"]) && isFinite(+datum[\"sum_people\"])"
        }
      ]
    },
    {
      "name": "data_0_curr",
      "source": "data_0",
      "transform": [
        {
          "type": "filter",
          "expr": "!length(data(\"animation_frame_store\")) || vlSelectionTest(\"animation_frame_store\", datum)"
        },
        {
          "type": "stack",
          "groupby": ["age"],
          "field": "sum_people",
          "sort": {"field": ["year"], "order": ["ascending"]},
          "as": ["sum_people_start", "sum_people_end"],
          "offset": "zero"
        }
      ]
    }
  ],
  "signals": [
    {"name": "y_step", "value": 20},
    {
      "name": "height",
      "update": "bandspace(domain('y').length, 0.1, 0.05) * y_step"
    },
    {
      "name": "unit",
      "value": {},
      "on": [
        {"events": "pointermove", "update": "isTuple(group()) ? group() : unit"}
      ]
    },
    {
      "name": "animation_frame",
      "update": "vlSelectionResolve(\"animation_frame_store\", \"union\", true, true)"
    },
    {
      "name": "anim_clock",
      "init": "0",
      "on": [
        {
          "events": {"type": "timer", "throttle": 16.666666666666668},
          "update": "is_playing ? (anim_clock + (now() - last_tick_at) > max_range_extent ? 0 : anim_clock + (now() - last_tick_at)) : anim_clock"
        }
      ]
    },
    {
      "name": "last_tick_at",
      "init": "now()",
      "on": [
        {
          "events": [{"signal": "anim_clock"}, {"signal": "is_playing"}],
          "update": "now()"
        }
      ]
    },
    {"name": "is_playing", "init": "true"},
    {"name": "eased_anim_clock", "update": "anim_clock"},
    {"name": "animation_frame_domain", "init": "domain('time')"},
    {"name": "min_extent", "init": "extent(animation_frame_domain)[0]"},
    {"name": "max_range_extent", "init": "extent(range('time'))[1]"},
    {"name": "anim_value", "update": "invert('time', eased_anim_clock)"},
    {
      "name": "animation_frame_tuple",
      "update": "{unit: \"\", fields: animation_frame_tuple_fields, values: [anim_value ? anim_value : min_extent]}"
    },
    {
      "name": "animation_frame_tuple_fields",
      "value": [{"type": "E", "field": "year"}]
    },
    {
      "name": "animation_frame_modify",
      "update": "modify(\"animation_frame_store\", animation_frame_tuple, true)"
    }
  ],
  "marks": [
    {
      "name": "marks",
      "type": "rect",
      "style": ["bar"],
      "interactive": true,
      "from": {"data": "data_0_curr"},
      "encode": {
        "update": {
          "cursor": {"value": "pointer"},
          "fill": {"value": "#4c78a8"},
          "ariaRoleDescription": {"value": "bar"},
          "description": {
            "signal": "\"population: \" + (format(datum[\"sum_people\"], \"\")) + \"; age: \" + (isValid(datum[\"age\"]) ? isArray(datum[\"age\"]) ? join(datum[\"age\"], ' ') : datum[\"age\"] : \"\"+datum[\"age\"]) + \"; year: \" + (isValid(datum[\"year\"]) ? isArray(datum[\"year\"]) ? join(datum[\"year\"], ' ') : datum[\"year\"] : \"\"+datum[\"year\"])"
          },
          "x": {"scale": "x", "field": "sum_people_end"},
          "x2": {"scale": "x", "field": "sum_people_start"},
          "y": {"scale": "y", "field": "age"},
          "height": {"signal": "max(0.25, bandwidth('y'))"}
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "data": "data_0_curr",
        "fields": ["sum_people_start", "sum_people_end"]
      },
      "range": [0, {"signal": "width"}],
      "nice": true,
      "zero": true
    },
    {
      "name": "y",
      "type": "band",
      "domain": {
        "data": "data_0_curr",
        "field": "age",
        "sort": {"op": "max", "field": "sum_people", "order": "descending"}
      },
      "range": {"step": {"signal": "y_step"}},
      "paddingInner": 0.1,
      "paddingOuter": 0.05
    },
    {
      "name": "time",
      "type": "band",
      "domain": {"data": "data_0", "field": "year", "sort": true},
      "range": {"step": 500}
    }
  ],
  "axes": [
    {
      "scale": "x",
      "orient": "bottom",
      "gridScale": "y",
      "grid": true,
      "tickCount": {"signal": "ceil(width/40)"},
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "population",
      "labelFlush": true,
      "labelOverlap": true,
      "tickCount": {"signal": "ceil(width/40)"},
      "zindex": 0
    },
    {"scale": "y", "orient": "left", "grid": false, "title": "age", "zindex": 0}
  ]
}
