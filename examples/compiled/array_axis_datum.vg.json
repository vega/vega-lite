{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "An elevation grid labelled in metres rather than cells, using its 10 m spacing.",
  "background": "white",
  "padding": 5,
  "width": 348,
  "height": 244,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "url": "data/volcano.json",
      "format": {"type": "json"},
      "transform": [
        {
          "type": "formula",
          "expr": "{width: datum.width, height: datum.height, values: datum.values}",
          "as": "__array_grid"
        },
        {
          "type": "formula",
          "expr": "extent(datum[\"values\"])[0]",
          "as": "array_min_values"
        },
        {
          "type": "formula",
          "expr": "extent(datum[\"values\"])[1]",
          "as": "array_max_values"
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "marks",
      "type": "image",
      "style": ["array"],
      "from": {"data": "source_0"},
      "encode": {
        "update": {
          "ariaRoleDescription": {"value": "array"},
          "description": {
            "signal": "\"values: \" + (format(datum[\"values\"], \"\"))"
          },
          "x": {"value": 0},
          "width": {"signal": "width"},
          "y": {"value": 0},
          "height": {"signal": "height"},
          "image": {"field": "image"},
          "aspect": {"value": false}
        }
      },
      "transform": [
        {
          "type": "heatmap",
          "field": "datum.__array_grid",
          "color": {"expr": "scale('color', datum.$value)"},
          "opacity": 1
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {"fields": [[0], [870]]},
      "range": [0, {"signal": "width"}]
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {"fields": [[0], [610]]},
      "range": [{"signal": "height"}, 0]
    },
    {
      "name": "color",
      "type": "linear",
      "domain": {
        "data": "source_0",
        "fields": ["array_min_values", "array_max_values"]
      },
      "range": {"scheme": "viridis"},
      "interpolate": "hcl",
      "zero": false
    }
  ],
  "axes": [
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "metres east",
      "labelFlush": true,
      "labelOverlap": true,
      "tickCount": {"signal": "ceil(width/40)"},
      "zindex": 0
    },
    {
      "scale": "y",
      "orient": "left",
      "grid": false,
      "title": "metres north",
      "labelOverlap": true,
      "tickCount": {"signal": "ceil(height/40)"},
      "zindex": 0
    }
  ],
  "legends": [
    {
      "fill": "color",
      "gradientLength": {"signal": "clamp(height, 64, 200)"},
      "title": "values"
    }
  ]
}
