{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A global grid labelled from the extent carried in its data.",
  "background": "white",
  "padding": 5,
  "width": 340,
  "height": 170,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "extent": [-180, 180, -81, 87],
          "width": 12,
          "height": 6,
          "values": [
            47,
