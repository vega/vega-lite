  "marks": [
    {
      "name": "marks",
      "type": "image",
      "style": ["array"],
      "from": {"data": "data_0"},
      "encode": {
        "update": {
          "ariaRoleDescription": {"value": "array"},
          "description": {
            "signal": "\"extent[0]: \" + (format(datum[\"extent.0\"], \"\")) + \"; extent[2]: \" + (format(datum[\"extent.2\"], \"\")) + \"; extent[1]: \" + (format(datum[\"extent.1\"], \"\")) + \"; extent[3]: \" + (format(datum[\"extent.3\"], \"\")) + \"; values: \" + (format(datum[\"values\"], \"\"))"
          },
          "x": {
            "signal": "min(scale('x', datum[\"extent.0\"]), scale('x', datum[\"extent.1\"]))"
          },
          "width": {
            "signal": "abs((scale('x', datum[\"extent.1\"])) - (scale('x', datum[\"extent.0\"])))"
          },
          "y": {
            "signal": "min(scale('y', datum[\"extent.2\"]), scale('y', datum[\"extent.3\"]))"
          },
          "height": {
            "signal": "abs((scale('y', datum[\"extent.3\"])) - (scale('y', datum[\"extent.2\"])))"
          },
          "image": {"field": "image"},
          "aspect": {"value": false}
        }
      },
      "transform": [
        {
          "type": "heatmap",
          "field": "datum.__array_grid",
          "color": {"expr": "scale('color', datum.$value)"},
          "opacity": 1
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {"data": "data_0", "fields": ["extent\\.0", "extent\\.1"]},
      "range": [0, {"signal": "width"}]
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {"data": "data_0", "fields": ["extent\\.2", "extent\\.3"]},
      "range": [{"signal": "height"}, 0]
    },
    {
      "name": "color",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "fields": ["array_min_values", "array_max_values"]
      },
      "range": {"scheme": "viridis"},
      "interpolate": "hcl",
      "zero": false
    }
  ],
