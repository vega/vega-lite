{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Annual precipitation on a global grid, beside the mean at each latitude.",
  "background": "white",
  "padding": 5,
  "height": 170,
  "data": [
    {
      "name": "source_0",
      "url": "data/annual-precip.json",
      "format": {"type": "json"},
      "transform": [
        {"type": "formula", "expr": "datum.translate[0]", "as": "west"},
        {
          "type": "formula",
          "expr": "datum.translate[0] + datum.width / datum.scale[0]",
          "as": "east"
        },
        {
          "type": "formula",
          "expr": "datum.translate[1] + datum.height / datum.scale[1]",
          "as": "south"
        },
        {"type": "formula", "expr": "datum.translate[1]", "as": "north"}
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "formula",
          "expr": "{width: datum.width, height: datum.height, values: datum[\"values\"]}",
          "as": "__array_grid"
        }
      ]
    },
    {
      "name": "data_1",
      "source": "source_0",
      "transform": [
        {"type": "flatten", "fields": ["values"], "as": ["cell"]},
        {
          "type": "window",
          "params": [null],
          "as": ["k"],
          "ops": ["row_number"],
          "fields": [null],
          "sort": {"field": [], "order": []}
        },
        {
          "type": "formula",
          "expr": "datum.translate[1] + (floor((datum.k - 1) / datum.width) + 0.5) / datum.scale[1]",
          "as": "lat"
        },
        {
          "type": "aggregate",
          "groupby": ["lat"],
          "ops": ["mean"],
          "fields": ["cell"],
          "as": ["zonal"]
        }
      ]
    }
  ],
  "signals": [
    {"name": "concat_0_width", "value": 340},
    {"name": "concat_1_width", "value": 90}
  ],
  "layout": {"padding": 8, "bounds": "full", "align": "each"},
  "marks": [
    {
      "type": "group",
      "name": "concat_0_group",
      "style": "cell",
      "encode": {
        "update": {
          "width": {"signal": "concat_0_width"},
          "height": {"signal": "height"}
        }
      },
      "marks": [
        {
          "name": "concat_0_marks",
          "type": "image",
          "style": ["array"],
          "from": {"data": "data_0"},
          "encode": {
            "update": {
              "ariaRoleDescription": {"value": "array"},
              "description": {
                "signal": "\"longitude: \" + (format(datum[\"west\"], \"\")) + \"; latitude: \" + (format(datum[\"south\"], \"\")) + \"; east: \" + (format(datum[\"east\"], \"\")) + \"; north: \" + (format(datum[\"north\"], \"\")) + \"; mm: \" + (format(extent(datum[\"values\"])[0], \"\") + \" – \" + format(extent(datum[\"values\"])[1], \"\"))"
              },
              "x": {
                "signal": "min(scale('concat_0_x', datum[\"west\"]), scale('concat_0_x', datum[\"east\"]))"
              },
              "width": {
                "signal": "abs((scale('concat_0_x', datum[\"east\"])) - (scale('concat_0_x', datum[\"west\"])))"
              },
              "y": {
                "signal": "min(scale('concat_0_y', datum[\"south\"]), scale('concat_0_y', datum[\"north\"]))"
              },
              "height": {
                "signal": "abs((scale('concat_0_y', datum[\"north\"])) - (scale('concat_0_y', datum[\"south\"])))"
              },
              "image": {"field": "image"},
              "aspect": {"value": false}
            }
          },
          "transform": [
            {
              "type": "heatmap",
              "field": "datum.__array_grid",
              "color": {"expr": "scale('color', datum.$value)"},
              "opacity": {"expr": "isValid(datum.$value) ? 1 : 0"}
            }
          ]
        }
      ],
      "axes": [
        {
          "scale": "concat_0_x",
          "orient": "bottom",
          "gridScale": "concat_0_y",
          "grid": true,
          "tickCount": {"signal": "ceil(concat_0_width/40)"},
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "concat_0_y",
          "orient": "left",
          "gridScale": "concat_0_x",
          "grid": true,
          "tickCount": {"signal": "ceil(height/40)"},
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "concat_0_x",
          "orient": "bottom",
          "grid": false,
          "title": "longitude",
          "labelFlush": true,
          "labelOverlap": true,
          "tickCount": {"signal": "ceil(concat_0_width/40)"},
          "zindex": 0
        },
        {
          "scale": "concat_0_y",
          "orient": "left",
          "grid": false,
          "title": "latitude",
          "labelOverlap": true,
          "tickCount": {"signal": "ceil(height/40)"},
          "zindex": 0
        }
      ]
    },
    {
      "type": "group",
      "name": "concat_1_group",
      "style": "cell",
      "encode": {
        "update": {
          "width": {"signal": "concat_1_width"},
          "height": {"signal": "height"}
        }
      },
      "marks": [
        {
          "name": "concat_1_marks",
          "type": "line",
          "style": ["line"],
          "sort": {"field": "y"},
          "from": {"data": "data_1"},
          "encode": {
            "update": {
              "stroke": {"value": "#4c78a8"},
              "description": {
                "signal": "\"zonal mean: \" + (format(datum[\"zonal\"], \"\")) + \"; lat: \" + (format(datum[\"lat\"], \"\"))"
              },
              "x": {"scale": "concat_1_x", "field": "zonal"},
              "y": {"scale": "concat_1_y", "field": "lat"},
              "defined": {
                "signal": "isValid(datum[\"zonal\"]) && isFinite(+datum[\"zonal\"]) && isValid(datum[\"lat\"]) && isFinite(+datum[\"lat\"])"
              }
            }
          }
        }
      ],
      "axes": [
        {
          "scale": "concat_1_x",
          "orient": "bottom",
          "tickCount": 3,
          "gridScale": "concat_1_y",
          "grid": true,
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "concat_1_x",
          "orient": "bottom",
          "grid": false,
          "title": "zonal mean",
          "tickCount": 3,
          "labelFlush": true,
          "labelOverlap": true,
          "zindex": 0
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "sqrt",
      "domain": [0, 4000],
      "range": {"scheme": "viridis"},
      "clamp": true,
      "interpolate": "hcl",
      "zero": true
    },
    {
      "name": "concat_0_x",
      "type": "linear",
      "domain": {"data": "data_0", "fields": ["west", "east"]},
      "range": [0, {"signal": "concat_0_width"}]
    },
    {
      "name": "concat_0_y",
      "type": "linear",
      "domain": {"data": "data_0", "fields": ["south", "north"]},
      "range": [{"signal": "height"}, 0]
    },
    {
      "name": "concat_1_x",
      "type": "linear",
      "domain": {"data": "data_1", "field": "zonal"},
      "range": [0, {"signal": "concat_1_width"}],
      "nice": true,
      "zero": true
    },
    {
      "name": "concat_1_y",
      "type": "linear",
      "domain": [-81, 87],
      "range": [{"signal": "height"}, 0],
      "zero": true
    }
  ],
  "legends": [
    {
      "title": "mm",
      "fill": "color",
      "gradientLength": {"signal": "clamp(height, 64, 200)"}
    }
  ]
}
