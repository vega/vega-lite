            37,
            38,
            30,
            29,
            29,
            29,
            30,
            31,
            31,
            31
          ]
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "formula",
          "expr": "{width: datum.width, height: datum.height, values: datum[\"values\"]}",
          "as": "__array_grid"
        },
        {
          "type": "formula",
          "expr": "extent(datum[\"values\"])[0]",
          "as": "array_min_values"
        },
        {
          "type": "formula",
          "expr": "extent(datum[\"values\"])[1]",
          "as": "array_max_values"
        }
      ]
    },
    {
      "name": "column_domain",
      "source": "data_0",
      "transform": [{"type": "aggregate", "groupby": ["variant"]}]
    }
  ],
  "signals": [
    {"name": "child_width", "value": 160},
    {"name": "child_height", "value": 120}
  ],
  "layout": {
    "padding": 20,
    "columns": {"signal": "length(data('column_domain'))"},
    "bounds": "full",
    "align": "all"
  },
  "marks": [
    {
      "name": "column_header",
      "type": "group",
      "role": "column-header",
      "from": {"data": "column_domain"},
      "sort": {"field": "datum[\"variant\"]", "order": "ascending"},
      "title": {
        "text": {
          "signal": "isValid(parent[\"variant\"]) ? parent[\"variant\"] : \"\"+parent[\"variant\"]"
        },
        "style": "guide-label",
        "frame": "group",
        "offset": 10
      },
      "encode": {"update": {"width": {"signal": "child_width"}}}
    },
    {
      "name": "cell",
      "type": "group",
      "style": "view",
      "from": {
        "facet": {"name": "facet", "data": "data_0", "groupby": ["variant"]}
      },
      "sort": {"field": ["datum[\"variant\"]"], "order": ["ascending"]},
      "encode": {
        "update": {
          "width": {"signal": "child_width"},
          "height": {"signal": "child_height"}
        }
      },
      "marks": [
        {
          "name": "child_marks",
          "type": "image",
          "style": ["array"],
          "from": {"data": "facet"},
          "encode": {
            "update": {
              "ariaRoleDescription": {"value": "array"},
              "description": {
                "signal": "\"values: \" + (format(extent(datum[\"values\"])[0], \"\") + \" – \" + format(extent(datum[\"values\"])[1], \"\"))"
              },
              "x": {"value": 0},
              "width": {"signal": "child_width"},
              "y": {"value": 0},
              "height": {"signal": "child_height"},
              "image": {"field": "image"},
              "aspect": {"value": false}
            }
          },
          "transform": [
            {
              "type": "heatmap",
              "field": "datum.__array_grid",
              "color": {"expr": "scale('color', datum.$value)"},
              "opacity": {"expr": "isValid(datum.$value) ? 1 : 0"}
            }
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "fields": ["array_min_values", "array_max_values"]
      },
      "range": {"scheme": "viridis"},
      "interpolate": "hcl",
      "zero": false
    }
  ],
  "legends": [
    {
      "fill": "color",
      "gradientLength": {"signal": "clamp(child_height, 64, 200)"},
      "title": "values"
    }
  ]
}
