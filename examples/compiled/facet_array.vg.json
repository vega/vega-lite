{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Two grids laid out in columns, sharing one color scale.",
  "background": "white",
  "padding": 5,
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "variant": "A",
          "width": 8,
          "height": 6,
          "values": [
            50,
            79,
            95,
            88,
            63,
