    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {"type": "formula", "expr": "0", "as": "__array_x0"},
        {"type": "formula", "expr": "0", "as": "__array_y0"},
        {
          "type": "formula",
          "expr": "{width: datum.width, height: datum.height, values: datum.values}",
          "as": "__array_grid"
        },
        {
          "type": "formula",
          "expr": "extent(datum[\"values\"])[0]",
          "as": "array_min_values"
        },
        {
          "type": "formula",
          "expr": "extent(datum[\"values\"])[1]",
          "as": "array_max_values"
        }
      ]
    },
    {
      "name": "column_domain",
      "source": "data_0",
      "transform": [{"type": "aggregate", "groupby": ["band"]}]
    },
    {
      "name": "row_domain",
      "source": "data_0",
      "transform": [{"type": "aggregate", "groupby": ["time"]}]
    }
  ],
  "signals": [
    {"name": "child_width", "value": 130},
    {"name": "child_height", "value": 98}
  ],
  "layout": {
    "padding": 20,
    "offset": {"rowTitle": 10, "columnTitle": 10},
    "columns": {"signal": "length(data('column_domain'))"},
    "bounds": "full",
    "align": "all"
  },
  "marks": [
    {
      "name": "row-title",
      "type": "group",
      "role": "row-title",
      "title": {
        "text": "time",
        "orient": "left",
        "style": "guide-title",
        "offset": 10
      }
    },
    {
      "name": "column-title",
      "type": "group",
      "role": "column-title",
      "title": {"text": "band", "style": "guide-title", "offset": 10}
    },
    {
      "name": "row_header",
      "type": "group",
      "role": "row-header",
      "from": {"data": "row_domain"},
      "sort": {"field": "datum[\"time\"]", "order": "ascending"},
      "title": {
        "text": {
          "signal": "isValid(parent[\"time\"]) ? parent[\"time\"] : \"\"+parent[\"time\"]"
        },
        "orient": "left",
        "style": "guide-label",
        "frame": "group",
        "offset": 10
      },
      "encode": {"update": {"height": {"signal": "child_height"}}}
    },
    {
      "name": "column_header",
      "type": "group",
      "role": "column-header",
      "from": {"data": "column_domain"},
      "sort": {"field": "datum[\"band\"]", "order": "ascending"},
      "title": {
        "text": {
          "signal": "isValid(parent[\"band\"]) ? parent[\"band\"] : \"\"+parent[\"band\"]"
        },
        "style": "guide-label",
        "frame": "group",
        "offset": 10
      },
      "encode": {"update": {"width": {"signal": "child_width"}}}
    },
    {
      "name": "column_footer",
      "type": "group",
      "role": "column-footer",
      "from": {"data": "column_domain"},
      "sort": {"field": "datum[\"band\"]", "order": "ascending"},
      "encode": {"update": {"width": {"signal": "child_width"}}},
      "axes": [
        {
          "scale": "x",
          "orient": "bottom",
          "grid": false,
          "labelFlush": true,
          "labelOverlap": true,
          "tickCount": {"signal": "ceil(child_width/40)"},
          "zindex": 0
        }
      ]
    },
    {
      "name": "cell",
      "type": "group",
      "style": "cell",
      "from": {
        "facet": {
          "name": "facet",
          "data": "data_0",
          "groupby": ["time", "band"],
          "aggregate": {"cross": true}
        }
      },
      "sort": {
        "field": ["datum[\"time\"]", "datum[\"band\"]"],
        "order": ["ascending", "ascending"]
      },
      "encode": {
        "update": {
          "width": {"signal": "child_width"},
          "height": {"signal": "child_height"}
        }
      },
      "marks": [
        {
          "name": "child_marks",
          "type": "image",
          "style": ["array"],
          "from": {"data": "facet"},
          "encode": {
            "update": {
              "ariaRoleDescription": {"value": "array"},
              "description": {
                "signal": "\"width: \" + (format(datum[\"width\"], \"\")) + \"; height: \" + (format(datum[\"height\"], \"\")) + \"; values: \" + (format(extent(datum[\"values\"])[0], \"\") + \" – \" + format(extent(datum[\"values\"])[1], \"\"))"
              },
              "x": {
                "signal": "min(scale('x', datum[\"__array_x0\"]), scale('x', datum[\"width\"]))"
              },
              "width": {
                "signal": "abs((scale('x', datum[\"width\"])) - (scale('x', datum[\"__array_x0\"])))"
              },
              "y": {
                "signal": "min(scale('y', datum[\"__array_y0\"]), scale('y', datum[\"height\"]))"
              },
              "height": {
                "signal": "abs((scale('y', datum[\"height\"])) - (scale('y', datum[\"__array_y0\"])))"
              },
              "image": {"field": "image"},
              "aspect": {"value": false}
            }
          },
          "transform": [
            {
              "type": "heatmap",
              "field": "datum.__array_grid",
              "color": {"expr": "scale('color', datum.$value)"},
              "opacity": {"expr": "isValid(datum.$value) ? 1 : 0"}
            }
          ]
        }
      ],
      "axes": [
        {
          "scale": "x",
          "orient": "bottom",
          "gridScale": "y",
          "grid": true,
          "tickCount": {"signal": "ceil(child_width/40)"},
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "y",
          "orient": "left",
          "gridScale": "x",
          "grid": true,
          "tickCount": {"signal": "ceil(child_height/40)"},
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "y",
          "orient": "left",
          "grid": false,
          "labelOverlap": true,
          "tickCount": {"signal": "ceil(child_height/40)"},
          "zindex": 0
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {"data": "data_0", "fields": ["__array_x0", "width"]},
      "range": [0, {"signal": "child_width"}]
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {"data": "data_0", "fields": ["__array_y0", "height"]},
      "range": [{"signal": "child_height"}, 0]
    },
    {
      "name": "color",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "fields": ["array_min_values", "array_max_values"]
      },
      "range": {"scheme": "viridis"},
      "interpolate": "hcl",
      "zero": false
    }
  ],
  "legends": [
    {
      "fill": "color",
      "gradientLength": {"signal": "clamp(child_height, 64, 200)"},
      "title": "values"
    }
  ]
}
