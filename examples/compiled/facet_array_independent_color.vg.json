  "signals": [
    {"name": "child_width", "value": 180},
    {"name": "child_height", "value": 135}
  ],
  "layout": {"padding": 20, "bounds": "full", "align": "all"},
  "marks": [
    {
      "name": "cell",
      "type": "group",
      "title": {
        "text": {
          "signal": "isValid(parent[\"variant\"]) ? parent[\"variant\"] : \"\"+parent[\"variant\"]"
        },
        "style": "guide-label",
        "frame": "group",
        "offset": 10
      },
      "style": "view",
      "from": {
        "facet": {"name": "facet", "data": "data_0", "groupby": ["variant"]}
      },
      "sort": {"field": ["datum[\"variant\"]"], "order": ["ascending"]},
      "encode": {
        "update": {
          "width": {"signal": "child_width"},
          "height": {"signal": "child_height"}
        }
      },
      "marks": [
        {
          "name": "child_marks",
          "type": "image",
          "style": ["array"],
          "from": {"data": "facet"},
          "encode": {
            "update": {
              "ariaRoleDescription": {"value": "array"},
              "description": {
                "signal": "\"values: \" + (format(datum[\"values\"], \"\"))"
              },
              "x": {"value": 0},
              "width": {"signal": "child_width"},
              "y": {"value": 0},
              "height": {"signal": "child_height"},
              "image": {"field": "image"},
              "aspect": {"value": false}
            }
          },
          "transform": [
            {
              "type": "heatmap",
              "field": "datum.__array_grid",
              "color": {"expr": "scale('child_color', datum.$value)"},
              "opacity": 1
            }
          ]
        }
      ],
      "scales": [
        {
          "name": "child_color",
          "type": "linear",
          "domain": {
            "data": "facet",
            "fields": ["array_min_values", "array_max_values"]
          },
          "range": {"scheme": "viridis"},
          "interpolate": "hcl",
          "zero": false
        }
      ],
      "legends": [
        {
          "fill": "child_color",
          "gradientLength": {"signal": "clamp(child_height, 64, 200)"},
          "title": "values"
        }
      ]
    }
  ]
