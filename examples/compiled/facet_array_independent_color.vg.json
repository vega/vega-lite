    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "formula",
          "expr": "{width: datum.width, height: datum.height, values: datum.values}",
          "as": "__array_grid"
        },
        {
          "type": "formula",
          "expr": "isArray(datum[\"values\"]) ? extent(datum[\"values\"])[0] : datum[\"values\"]",
          "as": "array_min_values"
        },
        {
          "type": "formula",
          "expr": "isArray(datum[\"values\"]) ? extent(datum[\"values\"])[1] : datum[\"values\"]",
          "as": "array_max_values"
        }
      ]
    }
