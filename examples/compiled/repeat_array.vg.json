  "signals": [{"name": "childWidth", "value": 170}],
  "layout": {"padding": 20, "bounds": "full", "align": "all"},
  "marks": [
    {
      "type": "group",
      "name": "child__temperature_group",
      "style": "view",
      "encode": {
        "update": {
          "width": {"signal": "childWidth"},
          "height": {"signal": "height"}
        }
      },
      "marks": [
        {
          "name": "child__temperature_marks",
          "type": "image",
          "style": ["array"],
          "from": {"data": "data_1"},
          "encode": {
            "update": {
              "ariaRoleDescription": {"value": "array"},
              "description": {
                "signal": "\"temperature: \" + (format(extent(datum[\"temperature\"])[0], \"\") + \" – \" + format(extent(datum[\"temperature\"])[1], \"\"))"
              },
              "x": {"value": 0},
              "width": {"signal": "childWidth"},
              "y": {"value": 0},
              "height": {"signal": "height"},
              "image": {"field": "image"},
              "aspect": {"value": false}
            }
          },
          "transform": [
            {
              "type": "heatmap",
              "field": "datum.__array_grid",
              "color": {
                "expr": "scale('child__temperature_color', datum.$value)"
              },
              "opacity": {"expr": "isValid(datum.$value) ? 1 : 0"}
            }
          ]
        }
      ],
      "legends": [
        {
          "fill": "child__temperature_color",
          "gradientLength": {"signal": "clamp(height, 64, 200)"},
          "title": "temperature"
        }
      ]
    },
    {
      "type": "group",
      "name": "child__rainfall_group",
      "style": "view",
      "encode": {
        "update": {
          "width": {"signal": "childWidth"},
          "height": {"signal": "height"}
        }
      },
      "marks": [
        {
          "name": "child__rainfall_marks",
          "type": "image",
          "style": ["array"],
          "from": {"data": "data_2"},
          "encode": {
            "update": {
              "ariaRoleDescription": {"value": "array"},
              "description": {
                "signal": "\"rainfall: \" + (format(extent(datum[\"rainfall\"])[0], \"\") + \" – \" + format(extent(datum[\"rainfall\"])[1], \"\"))"
              },
              "x": {"value": 0},
              "width": {"signal": "childWidth"},
              "y": {"value": 0},
              "height": {"signal": "height"},
              "image": {"field": "image"},
              "aspect": {"value": false}
            }
          },
          "transform": [
            {
              "type": "heatmap",
              "field": "datum.__array_grid",
              "color": {"expr": "scale('child__rainfall_color', datum.$value)"},
              "opacity": {"expr": "isValid(datum.$value) ? 1 : 0"}
            }
          ]
        }
      ],
      "legends": [
        {
          "fill": "child__rainfall_color",
          "gradientLength": {"signal": "clamp(height, 64, 200)"},
          "title": "rainfall"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "child__temperature_color",
      "type": "linear",
      "domain": {
        "data": "data_1",
        "fields": ["array_min_temperature", "array_max_temperature"]
      },
      "range": {"scheme": "viridis"},
      "interpolate": "hcl",
      "zero": false
    },
    {
      "name": "child__rainfall_color",
      "type": "linear",
      "domain": {
        "data": "data_2",
        "fields": ["array_min_rainfall", "array_max_rainfall"]
      },
      "range": {"scheme": "viridis"},
      "interpolate": "hcl",
      "zero": false
    }
  ]
}
