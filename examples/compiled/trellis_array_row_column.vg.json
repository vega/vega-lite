    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "formula",
          "expr": "{width: datum.width, height: datum.height, values: datum.values}",
          "as": "__array_grid"
        },
        {
          "type": "formula",
          "expr": "isArray(datum[\"values\"]) ? extent(datum[\"values\"])[0] : datum[\"values\"]",
          "as": "array_min_values"
        },
        {
          "type": "formula",
          "expr": "isArray(datum[\"values\"]) ? extent(datum[\"values\"])[1] : datum[\"values\"]",
          "as": "array_max_values"
        }
      ]
    },
    {
      "name": "column_domain",
      "source": "data_0",
      "transform": [{"type": "aggregate", "groupby": ["band"]}]
    },
    {
      "name": "row_domain",
      "source": "data_0",
      "transform": [{"type": "aggregate", "groupby": ["time"]}]
    }
  ],
  "signals": [
    {"name": "child_width", "value": 90},
    {"name": "child_height", "value": 72}
  ],
  "layout": {
    "padding": 20,
    "offset": {"rowTitle": 10, "columnTitle": 10},
    "columns": {"signal": "length(data('column_domain'))"},
    "bounds": "full",
    "align": "all"
  },
  "marks": [
    {
      "name": "row-title",
      "type": "group",
      "role": "row-title",
      "title": {
        "text": "time",
        "orient": "left",
        "style": "guide-title",
        "offset": 10
      }
    },
    {
      "name": "column-title",
      "type": "group",
      "role": "column-title",
      "title": {"text": "band", "style": "guide-title", "offset": 10}
    },
    {
      "name": "row_header",
      "type": "group",
      "role": "row-header",
      "from": {"data": "row_domain"},
      "sort": {"field": "datum[\"time\"]", "order": "ascending"},
      "title": {
        "text": {
          "signal": "isValid(parent[\"time\"]) ? parent[\"time\"] : \"\"+parent[\"time\"]"
        },
        "orient": "left",
        "style": "guide-label",
        "frame": "group",
        "offset": 10
      },
      "encode": {"update": {"height": {"signal": "child_height"}}}
    },
    {
      "name": "column_header",
      "type": "group",
      "role": "column-header",
      "from": {"data": "column_domain"},
      "sort": {"field": "datum[\"band\"]", "order": "ascending"},
      "title": {
        "text": {
          "signal": "isValid(parent[\"band\"]) ? parent[\"band\"] : \"\"+parent[\"band\"]"
        },
        "style": "guide-label",
        "frame": "group",
        "offset": 10
      },
      "encode": {"update": {"width": {"signal": "child_width"}}}
    },
    {
      "name": "cell",
      "type": "group",
      "style": "view",
      "from": {
        "facet": {
          "name": "facet",
          "data": "data_0",
          "groupby": ["time", "band"],
          "aggregate": {"cross": true}
        }
      },
      "sort": {
        "field": ["datum[\"time\"]", "datum[\"band\"]"],
        "order": ["ascending", "ascending"]
      },
      "encode": {
        "update": {
          "width": {"signal": "child_width"},
          "height": {"signal": "child_height"}
        }
      },
      "marks": [
        {
          "name": "child_marks",
          "type": "image",
          "style": ["array"],
          "from": {"data": "facet"},
          "encode": {
            "update": {
              "ariaRoleDescription": {"value": "array"},
              "description": {
                "signal": "\"values: \" + (format(datum[\"values\"], \"\"))"
              },
              "x": {"value": 0},
              "width": {"signal": "child_width"},
              "y": {"value": 0},
              "height": {"signal": "child_height"},
              "image": {"field": "image"},
              "aspect": {"value": false}
            }
          },
          "transform": [
            {
              "type": "heatmap",
              "field": "datum.__array_grid",
              "color": {"expr": "scale('color', datum.$value)"},
              "opacity": 1
            }
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "fields": ["array_min_values", "array_max_values"]
      },
      "range": {"scheme": "viridis"},
      "interpolate": "hcl",
      "zero": false
    }
  ],
  "legends": [
    {
      "fill": "color",
      "gradientLength": {"signal": "clamp(child_height, 64, 200)"},
      "title": "values"
    }
  ]
}
