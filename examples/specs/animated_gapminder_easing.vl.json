{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Gapminder animated over time, with easing, so each transition accelerates away from one year and settles into the next.",
  "data": {
    "url": "data/gapminder.json"
  },
  "mark": "point",
  "params": [
    {
      "name": "animation_frame",
      "select": {
        "type": "point",
        "on": "timer",
        "easing": "easeCubicInOut"
      }
    }
  ],
  "transform": [
    {
      "filter": {
        "param": "animation_frame"
      }
    }
  ],
  "encoding": {
    "color": {
      "field": "cluster",
      "type": "nominal"
    },
    "x": {
      "field": "fertility",
      "type": "quantitative"
    },
    "y": {
      "field": "life_expect",
      "type": "quantitative"
    },
    "time": {
      "field": "year",
      "type": "ordinal",
      "key": {
        "field": "country"
      }
    }
  }
}
