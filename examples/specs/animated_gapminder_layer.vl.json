{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Gapminder animated over time, with a labelled layer riding along on the same clock.",
  "data": {
    "url": "data/gapminder.json"
  },
  "transform": [
    {
      "filter": "datum.pop > 100000000"
    }
  ],
  "encoding": {
    "x": {
      "field": "fertility",
      "type": "quantitative"
    },
    "y": {
      "field": "life_expect",
      "type": "quantitative"
    },
    "time": {
      "field": "year",
      "type": "ordinal"
    }
  },
  "layer": [
    {
      "mark": "point"
    },
    {
      "mark": {
        "type": "text",
        "dy": -10,
        "fontSize": 8
      },
      "encoding": {
        "text": {
          "field": "country"
        }
      }
    }
  ]
}
