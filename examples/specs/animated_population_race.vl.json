{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A racing bar chart of US population by age group, animated across census years.",
  "data": {
    "url": "data/population.json"
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "aggregate": "sum",
      "field": "people",
      "type": "quantitative",
      "title": "population"
    },
    "y": {
      "field": "age",
      "type": "ordinal",
      "sort": {
        "field": "people",
        "op": "sum",
        "order": "descending"
      }
    },
    "time": {
      "field": "year",
      "type": "ordinal",
      "rescale": true
    }
  }
}
