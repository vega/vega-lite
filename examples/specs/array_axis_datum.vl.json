{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "An elevation grid labelled in metres rather than cells, using its 10 m spacing.",
  "width": 348,
  "height": 244,
  "data": {"url": "data/volcano.json"},
  "mark": "array",
  "encoding": {
    "x": {"datum": 0, "type": "quantitative", "axis": {"title": "metres east"}},
    "x2": {"datum": 870},
    "y": {
      "datum": 0,
      "type": "quantitative",
      "axis": {"title": "metres north"}
    },
    "y2": {"datum": 610},
    "color": {
      "field": "values",
      "type": "quantitative",
      "scale": {"scheme": "viridis"}
    }
  }
}
