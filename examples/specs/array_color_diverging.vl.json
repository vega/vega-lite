{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "An elevation grid with a diverging color scheme centred on a chosen elevation.",
  "width": 348,
  "height": 244,
  "data": {"url": "data/volcano.json"},
  "mark": "array",
  "encoding": {
    "color": {
      "field": "values",
      "type": "quantitative",
      "scale": {"scheme": "redblue", "domainMid": 140, "reverse": true}
    }
  }
}
