{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "An elevation grid labelled with its own extent, in cells.",
  "width": 348,
  "height": 244,
  "data": {"url": "data/volcano.json"},
  "transform": [
    {"calculate": "0", "as": "__array_x0"},
    {"calculate": "0", "as": "__array_y0"}
  ],
  "mark": {"type": "array"},
  "encoding": {
    "x": {"field": "__array_x0", "type": "quantitative", "title": null},
    "x2": {"field": "width"},
    "y": {"field": "__array_y0", "type": "quantitative", "title": null},
    "y2": {"field": "height"},
    "color": {
      "field": "values",
      "type": "quantitative",
      "scale": {"scheme": "viridis"}
    }
  }
}