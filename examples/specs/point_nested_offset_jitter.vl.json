{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A jittered dot plot using a nested categorical and quantitative position offset.",
  "data": {"url": "data/penguins.json"},
  "transform": [
    {"filter": {"field": "Sex", "oneOf": ["MALE", "FEMALE"]}},
    {"calculate": "random()", "as": "jitter"}
  ],
  "mark": {"type": "point", "filled": true, "opacity": 0.7},
  "encoding": {
    "x": {"field": "Body Mass (g)", "type": "quantitative"},
    "y": {"field": "Species", "type": "nominal"},
    "yOffset": [
      {
        "field": "Sex",
        "type": "nominal",
        "scale": {"paddingInner": 0.2, "paddingOuter": 0.1}
      },
      {"field": "jitter", "type": "quantitative"}
    ],
    "color": {"field": "Sex", "type": "nominal"}
  }
}
