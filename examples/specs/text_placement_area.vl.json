{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Labels avoid the area's line but not its fill, which covers most of the plot.",
  "data": {
    "url": "data/stocks.csv"
  },
  "transform": [
    {
      "filter": "datum.symbol === 'AAPL' && year(datum.date) >= 2007"
    }
  ],
  "width": 400,
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal"
    },
    "y": {
      "field": "price",
      "type": "quantitative"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": true,
        "opacity": 0.3
      }
    },
    {
      "mark": {
        "type": "text",
        "placement": {
          "anchor": [
            "top",
            "bottom"
          ],
          "offset": [
            3,
            3
          ],
          "avoid": [
            {
              "mark": "line"
            }
          ]
        }
      },
      "encoding": {
        "text": {
          "field": "price",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    }
  ]
}
